# PostgreSQL Connection URL (connects as non-superuser, non-owner role `bomapos_app` so RLS is enforced)
DATABASE_URL=postgresql+psycopg://bomapos_app:bomapos_app@localhost:5432/bomapos

# Admin / Migration URL (schema owner used for running `alembic upgrade head`)
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bomapos

# Separate test database URLs for running the test suite
TEST_DATABASE_URL=postgresql+psycopg://bomapos_app:bomapos_app@localhost:5432/bomapos_test
TEST_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bomapos_test

# JWT Signing Key (must be at least 32 characters)
JWT_SECRET=change-this-to-a-32-char-minimum-production-secret-key!

# Comma-separated list of allowed CORS origins (no wildcard '*')
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Number of trusted reverse proxies in front of the application (default 0).
# When 0: X-Forwarded-For is ignored and request.client.host is used.
# When N > 0: the Nth entry counting from the right of X-Forwarded-For is used.
TRUSTED_PROXY_COUNT=0

# Lenco Payment Gateway Configuration ('mock' or 'live')
LENCO_MODE=mock
LENCO_API_TOKEN=replace-with-your-lenco-secret-api-token
LENCO_API_BASE_URL=https://api.lenco.co/access/v2
LENCO_PHONE_FORMAT=local

# Internal Cron Reconciliation Secret (required when LENCO_MODE=live)
CRON_SECRET=replace-with-cron-secret-for-internal-reconcile
